# ==============================================================================
# Rikkei Jobs Monorepo - Git Ignore Configuration
# ==============================================================================

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# Environment Variables & Sensitive Credentials
# ONLY .env.example should be tracked in Git. Real environment files are strictly ignored.
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12

# Java / Maven Build Artifacts (backend)
backend/target/
**/target/
*.class
*.jar
*.war
*.ear
*.nar
*.zip
*.tar.gz
*.rar
hs_err_pid*
replay_pid*
.attach_pid*

# Node / NPM / Vite / Frontend & Mock Artifacts
node_modules/
**/node_modules/
dist/
**/dist/
build/
**/build/
.vite/
**/.vite/
coverage/
**/coverage/
.nyc_output/
*.lcov
*.tsbuildinfo

# Logs & Runtime Diagnostics
logs/
**/logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# IDE & Editor Files
.idea/
*.iml
*.iws
*.ipr
out/
.project
.classpath
.settings/
.factorypath
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.sublime-project
*.sublime-workspace

# Docker & Database runtime data
docker/data/
docker-volumes/
postgres_data/

# Temporary / Scratch Files
tmp/
temp/
*.tmp
*.bak
*.swp
*~
docs/nt01/pr-screenshots/

# ==============================================================================
# AI Coding Agent Configuration (.claude & .gemini mirrors)
# Track only rules, skills, commands, and project-level settings.
# ==============================================================================
.claude/*
!.claude/rules/
!.claude/skills/
!.claude/settings.json
.claude/*.local.*
.claude/**/*.local.*

.gemini/*
!.gemini/rules/
!.gemini/skills/
!.gemini/commands/
!.gemini/settings.json
.gemini/*.local.*
.gemini/**/*.local.*

.agents/*