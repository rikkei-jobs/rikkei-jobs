# ==============================================================================
# Rikkei Jobs Environment Configuration (.env.example)
# Task T022DB0 - Sprint 1 Skeleton & External Systems Mock
#
# Usage:
#   cp .env.example .env
#   docker compose up -d --build --wait
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database Configuration (PostgreSQL 18.6)
# ------------------------------------------------------------------------------
POSTGRES_DB=rikkeijobs
POSTGRES_USER=rikkei_app
POSTGRES_PASSWORD=rikkei_secret
# Host port mapping (bound to 127.0.0.1:5433 to avoid collision with local 5432)
POSTGRES_PORT=5433
POSTGRES_HOST=postgres

# ------------------------------------------------------------------------------
# 2. Backend Service Configuration (Spring Boot 4.1.2 + Java 25 LTS)
# ------------------------------------------------------------------------------
# Host port mapping (bound to 127.0.0.1:8080)
BACKEND_PORT=8080
SPRING_PROFILES_ACTIVE=dev
# CORS allowed origins (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# JWT Secret (minimum 32 bytes; development convenience only)
JWT_SECRET=dev-insecure-jwt-secret-key-rikkei-jobs-min-32-chars

# ------------------------------------------------------------------------------
# 3. Frontend Service Configuration (React 19 + TypeScript + Vite 8 + Nginx)
# ------------------------------------------------------------------------------
# Host port mapping (bound to 127.0.0.1:3000)
FRONTEND_PORT=3000
VITE_API_BASE_URL=/api/v1

# ------------------------------------------------------------------------------
# 4. External Systems Mock Configuration (Node.js 24 + Express 5.3.0)
# ------------------------------------------------------------------------------
# Host port mapping (bound to 127.0.0.1:9000)
MOCK_PORT=9000
# Base URL for backend calls:
# - In Docker Compose: http://mock:9000
# - Standalone host development: http://localhost:9000
EXTERNAL_BASE_URL=http://mock:9000
EXTERNAL_SERVICE_KEY=dev-key

# ------------------------------------------------------------------------------
# 5. Mailpit Mock SMTP & Web UI (axllent/mailpit:v1.33.1)
# ------------------------------------------------------------------------------
MAILPIT_HOST=mailpit
# Host port mappings (bound to 127.0.0.1)
MAILPIT_UI_PORT=8025
MAILPIT_SMTP_PORT=1025
SPRING_MAIL_HOST=mailpit
SPRING_MAIL_PORT=1025

# ------------------------------------------------------------------------------
# 6. Cloudinary Logo Storage Configuration (Round DN-01-cloud / T0231B5)
# ------------------------------------------------------------------------------
# Dummy non-secret defaults below work with the local mock server (used by CI).
# Never commit real Cloudinary credentials to Git; keep them only in .env.
#
# To switch to a real Cloudinary account in .env:
#   1. Set CLOUDINARY_CLOUD_NAME, CLOUDINARY_API_KEY, and CLOUDINARY_API_SECRET
#      to your real Cloudinary credentials.
#   2. Set CLOUDINARY_API_BASE_URL=https://api.cloudinary.com/v1_1
#      (or comment it out to fall back to the local mock at http://mock:9000/cloudinary/v1_1).
#   3. Set CLOUDINARY_DELIVERY_BASE_URL=https://res.cloudinary.com/<your-cloud-name>/image/upload
#      (must match the secure_url prefix returned by Cloudinary).
#   4. Restart the backend container/process.
CLOUDINARY_CLOUD_NAME=dev-cloud
CLOUDINARY_API_KEY=dev-key
CLOUDINARY_API_SECRET=dev-secret
CLOUDINARY_API_BASE_URL=http://mock:9000/cloudinary/v1_1
CLOUDINARY_DELIVERY_BASE_URL=http://127.0.0.1:9000/cloudinary
CLOUDINARY_TIMEOUT_SECONDS=5
# Browser-reachable public base URL embedded in mock secure_url responses:
MOCK_PUBLIC_BASE_URL=http://127.0.0.1:9000
