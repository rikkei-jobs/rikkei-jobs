# ==============================================================================
# Rikkei Jobs Environment Configuration (.env.example)
# Task T022DB0 - Sprint 1 Skeleton & External Systems Mock
#
# Usage:
#   cp .env.example .env
#   docker compose up -d --build --wait
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database Configuration (PostgreSQL 18.6)
# ------------------------------------------------------------------------------
POSTGRES_DB=rikkeijobs
POSTGRES_USER=rikkei_app
POSTGRES_PASSWORD=rikkei_secret
# Host port mapping (bound to 127.0.0.1:5433 to avoid collision with local 5432)
POSTGRES_PORT=5433
POSTGRES_HOST=postgres

# ------------------------------------------------------------------------------
# 2. Backend Service Configuration (Spring Boot 4.1.2 + Java 25 LTS)
# ------------------------------------------------------------------------------
# Host port mapping (bound to 127.0.0.1:8080)
BACKEND_PORT=8080
SPRING_PROFILES_ACTIVE=dev
# CORS allowed origins (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# JWT Secret (minimum 32 bytes; development convenience only)
JWT_SECRET=dev-insecure-jwt-secret-key-rikkei-jobs-min-32-chars

# ------------------------------------------------------------------------------
# 3. Frontend Service Configuration (React 19 + TypeScript + Vite 8 + Nginx)
# ------------------------------------------------------------------------------
# Host port mapping (bound to 127.0.0.1:3000)
FRONTEND_PORT=3000
VITE_API_BASE_URL=/api/v1

# ------------------------------------------------------------------------------
# 4. External Systems Mock Configuration (Node.js 24 + Express 5.3.0)
# ------------------------------------------------------------------------------
# Host port mapping (bound to 127.0.0.1:9000)
MOCK_PORT=9000
# Base URL for backend calls:
# - In Docker Compose: http://mock:9000
# - Standalone host development: http://localhost:9000
EXTERNAL_BASE_URL=http://mock:9000
EXTERNAL_SERVICE_KEY=dev-key

# ------------------------------------------------------------------------------
# 5. Mailpit Mock SMTP & Web UI (axllent/mailpit:v1.33.1)
# ------------------------------------------------------------------------------
MAILPIT_HOST=mailpit
# Host port mappings (bound to 127.0.0.1)
MAILPIT_UI_PORT=8025
MAILPIT_SMTP_PORT=1025
SPRING_MAIL_HOST=mailpit
SPRING_MAIL_PORT=1025
